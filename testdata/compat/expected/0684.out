    "sentences": [
     "\u4eca\u56de\u306e\u5909\u66f4\u3067\u306f\u3001API\u30b5\u30fc\u30d0\u30fc\u304c\u671f\u9650\u5207\u308c\u9593\u8fd1\u306e\u30c8\u30fc\u30af\u30f3\u3092\u30ad\u30e5\u30fc\u306b\u767b\u9332\u3057\u3001\u30ef\u30fc\u30ab\u30fc\u304c\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u8981\u6c42\u3092\u9001\u3063\u3066\u65b0\u3057\u3044\u30c8\u30fc\u30af\u30f3\u3092\u53d6\u5f97\u3057\u307e\u3059\u3002",
     "\u540c\u4e00\u30e6\u30fc\u30b6\u30fc\u306e\u30b8\u30e7\u30d6\u306f\u3001\u30e6\u30fc\u30b6\u30fcID\u3092\u30ad\u30fc\u306b\u91cd\u8907\u3092\u53d6\u308a\u9664\u304d\u307e\u3059\u3002",
     "\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u306b\u5931\u6557\u3057\u305f\u5834\u5408\u3001\u30ef\u30fc\u30ab\u30fc\u306f\u6307\u6570\u30d0\u30c3\u30af\u30aa\u30d5\u3067\u9593\u9694\u3092\u7a7a\u3051\u306a\u304c\u3089\u6700\u59273\u56de\u307e\u3067\u518d\u8a66\u884c\u3057\u307e\u3059\u3002",
     "3\u56de\u5931\u6557\u3059\u308b\u3068\u3001\u30ef\u30fc\u30ab\u30fc\u306f\u305d\u306e\u30e6\u30fc\u30b6\u30fc\u3092\u518d\u30ed\u30b0\u30a4\u30f3\u304c\u5fc5\u8981\u306a\u72b6\u614b\u306b\u5207\u308a\u66ff\u3048\u307e\u3059\u3002"
    ]
