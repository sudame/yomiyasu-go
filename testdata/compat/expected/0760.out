     "\u5177\u4f53\u7684\u306b\u306f\u3001\u6c38\u7d9a\u5316\u3092Repository\u306b\u3001\u5916\u90e8API\u547c\u3073\u51fa\u3057\u3092Gateway\u307e\u305f\u306fClient\u306b\u5207\u308a\u51fa\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
