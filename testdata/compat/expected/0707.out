 "lost_words": [
  "\u4f5c\u696d\u524d"
 ],
 "structure": [
  "\u6bb5\u843d\u3092\u307e\u3068\u3081\u305f\uff0812 \u2192 9\uff09\u3002\u307e\u3068\u3081\u305f\u6bb5\u843d\u306e\u8a71\u984c\u304c1\u3064\u304b\u898b\u308b"
 ],
 "spans": [],
 "logic": [
  {
   "kind": "\u4e3b\u984c\u306e\u300c\u3082\u300d",
   "sentence": "\u4f5c\u696d\u304c\u60f3\u5b9a\u3088\u308a\u9577\u5f15\u304f\u5834\u5408\u3082\u3001\u3053\u306e\u30c1\u30e3\u30f3\u30cd\u30eb\u3067\u968f\u6642\u304a\u77e5\u3089\u305b\u3057\u307e\u3059\u3002"
  }
 ],
 "bold": [],
 "endings": {
  "stance": "\u8aac\u660e",
  "changes": [
   {
    "orig": "\u304a\u9858\u3044\u3057\u305f\u3044\u3053\u3068\u306f3\u70b9\u3042\u308a\u307e\u3059\u3002",
    "orig_kind": "\u8aac\u660e\uff08\u301c\u307e\u3059\uff09",
    "rewrite": "\u6b21\u306e3\u70b9\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002",
    "rewrite_kind": "\u52d5\u4f5c\uff08\u301c\u3057\u307e\u3059\uff09"
   }
  ],
  "flags": [
   {
    "note": "\u4e8b\u5b9f\u30fb\u7d50\u679c\u30fb\u8003\u3048\u306e\u6587\u66f8\u306b\u3001\u8aad\u307f\u624b\u3078\u306e\u52e7\u3081\u3084\u983c\u307f\u304c\u3042\u308b\uff08\u6700\u5f8c\u306e1\u6587\u3092\u9664\u304f\uff09\u3002\u7acb\u5834\u304c\u5408\u3063\u3066\u3044\u308b\u304b\u898b\u308b",
    "sentences": [
     "\u696d\u52d9\u306b\u5f71\u97ff\u304c\u3042\u308b\u65b9\u306f\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002",
     "\u505c\u6b62\u6642\u9593\u5e2f\u306b\u4e88\u5b9a\u3057\u3066\u3044\u308b\u30d0\u30c3\u30c1\u51e6\u7406\u3084\u30c7\u30d7\u30ed\u30a4\u306f\u3001\u524d\u5f8c\u306e\u65e5\u7a0b\u3078\u79fb\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
     "\u304a\u5ba2\u69d8\u3078\u306e\u6848\u5185\u304c\u5fc5\u8981\u306a\u5834\u5408\u306f\u3001\u30ab\u30b9\u30bf\u30de\u30fc\u30b5\u30dd\u30fc\u30c8\u30c1\u30fc\u30e0\u3078\u4e8b\u524d\u306b\u5171\u6709\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
     "\u672a\u4fdd\u5b58\u306e\u30c7\u30fc\u30bf\u304c\u6b8b\u3089\u306a\u3044\u3088\u3046\u300110\u67083\u65e5\uff08\u571f\uff09\u4e2d\u306b\u5165\u529b\u5185\u5bb9\u3092\u4fdd\u5b58\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
     "\u5fa9\u65e7\u5f8c\u306b\u4e0d\u5177\u5408\u3092\u898b\u3064\u3051\u305f\u5834\u5408\u306f\u3001\u3053\u306e\u30b9\u30ec\u30c3\u30c9\u306b\u8fd4\u4fe1\u3059\u308b\u304b\u3001#infra-support\u3078\u9023\u7d61\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
    ]
   }
  ],
  "orig_flags": [
   {
    "note": "\u4e8b\u5b9f\u30fb\u7d50\u679c\u30fb\u8003\u3048\u306e\u6587\u66f8\u306b\u3001\u8aad\u307f\u624b\u3078\u306e\u52e7\u3081\u3084\u983c\u307f\u304c\u3042\u308b\uff08\u6700\u5f8c\u306e1\u6587\u3092\u9664\u304f\uff09\u3002\u7acb\u5834\u304c\u5408\u3063\u3066\u3044\u308b\u304b\u898b\u308b",
    "sentences": [
     "\u4f5c\u696d\u4e2d\u306f\u672c\u756a\u30b5\u30fc\u30d3\u30b9\u3092\u4e00\u6642\u505c\u6b62\u3059\u308b\u305f\u3081\u3001\u696d\u52d9\u3078\u306e\u5f71\u97ff\u304c\u3042\u308b\u65b9\u306f\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002",
     "\u30fb\u505c\u6b62\u6642\u9593\u5e2f\u306b\u4e88\u5b9a\u3057\u3066\u3044\u308b\u30d0\u30c3\u30c1\u51e6\u7406\u3084\u30c7\u30d7\u30ed\u30a4\u306f\u3001\u524d\u5f8c\u306e\u65e5\u7a0b\u3078\u79fb\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
     "\u30fb\u304a\u5ba2\u69d8\u3078\u306e\u6848\u5185\u304c\u5fc5\u8981\u306a\u5834\u5408\u306f\u3001\u30ab\u30b9\u30bf\u30de\u30fc\u30b5\u30dd\u30fc\u30c8\u30c1\u30fc\u30e0\u3078\u4e8b\u524d\u306b\u5171\u6709\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
     "\u30fb\u4f5c\u696d\u524d\u306b\u672a\u4fdd\u5b58\u306e\u30c7\u30fc\u30bf\u304c\u6b8b\u3089\u306a\u3044\u3088\u3046\u300110\u67083\u65e5(\u571f)\u4e2d\u306b\u5165\u529b\u5185\u5bb9\u306e\u4fdd\u5b58\u3092\u6e08\u307e\u305b\u3066\u304f\u3060\u3055\u3044\u3002",
     "\u5fa9\u65e7\u5f8c\u306b\u4e0d\u5177\u5408\u3092\u898b\u3064\u3051\u305f\u5834\u5408\u306f\u3001\u3053\u306e\u30b9\u30ec\u30c3\u30c9\u306b\u8fd4\u4fe1\u3059\u308b\u304b\u3001#infra-support \u3078\u9023\u7d61\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
    ]
   }
  ]
 }
}
