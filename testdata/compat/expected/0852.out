     "1. \u8ca0\u8377\u8a66\u9a13\u306b\u57fa\u3065\u304f\u30d7\u30fc\u30eb\u30b5\u30a4\u30ba\u306e\u518d\u8a2d\u8a08\u3068\u3001\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u5074\u306e\u6700\u5927\u63a5\u7d9a\u6570\u3068\u306e\u6574\u5408\u78ba\u8a8d\u3092\u884c\u3046\u3002",
     "2. \u9577\u6642\u9593\u30af\u30a8\u30ea\u306e\u6700\u9069\u5316\u3068\u3001\u30af\u30a8\u30ea\u304a\u3088\u3073\u63a5\u7d9a\u53d6\u5f97\u306e\u30bf\u30a4\u30e0\u30a2\u30a6\u30c8\u8a2d\u5b9a\u3092\u9069\u6b63\u5316\u3059\u308b\u3002",
     "3. \u30d7\u30fc\u30eb\u4f7f\u7528\u7387\u3068\u63a5\u7d9a\u5f85\u3061\u6642\u9593\u306e\u76e3\u8996\u3092\u5c0e\u5165\u3057\u3001\u95be\u5024\u8d85\u904e\u6642\u306b\u8b66\u5831\u3092\u767a\u5831\u3059\u308b\u3002"
