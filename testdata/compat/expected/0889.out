  "flags": [
   {
    "note": "\u4e8b\u5b9f\u30fb\u7d50\u679c\u30fb\u8003\u3048\u306e\u6587\u66f8\u306b\u3001\u8aad\u307f\u624b\u3078\u306e\u52e7\u3081\u3084\u983c\u307f\u304c\u3042\u308b\uff08\u6700\u5f8c\u306e1\u6587\u3092\u9664\u304f\uff09\u3002\u7acb\u5834\u304c\u5408\u3063\u3066\u3044\u308b\u304b\u898b\u308b",
    "sentences": [
     "\u4f5c\u696d\u4e2d\u306f\u672c\u756a\u74b0\u5883\u306e\u30b5\u30fc\u30d3\u30b9\u3092\u505c\u6b62\u3057\u307e\u3059\u306e\u3067\u3001\u3054\u6ce8\u610f\u304f\u3060\u3055\u3044\u3002",
     "\u55b6\u696d\u30fbCS\u62c5\u5f53\u306e\u65b9\u306f\u3001\u304a\u5ba2\u69d8\u3078\u306e\u6848\u5185\u304c\u5fc5\u8981\u306b\u306a\u308b\u5834\u5408\u306b\u5099\u3048\u3066\u3001\u4e8b\u524d\u306b\u65e5\u7a0b\u3092\u304a\u5ba2\u69d8\u3078\u5171\u6709\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
     "\u958b\u767a\u62c5\u5f53\u306e\u65b9\u306f\u3001\u505c\u6b62\u6642\u9593\u4e2d\u306b\u5b9f\u884c\u3059\u308b\u30d0\u30c3\u30c1\u3084\u30c7\u30d7\u30ed\u30a4\u306e\u4e88\u5b9a\u304c\u306a\u3044\u304b\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
     "\u518d\u958b\u5f8c\u306b\u4e0d\u5177\u5408\u3092\u898b\u3064\u3051\u305f\u5834\u5408\u306f\u3001#infra-support \u307e\u3067\u304a\u77e5\u3089\u305b\u304f\u3060\u3055\u3044\u3002"
    ]
   }
