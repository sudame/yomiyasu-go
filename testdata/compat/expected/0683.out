    "orig_kind": "\u4f9d\u983c",
    "rewrite": "\u30ec\u30d3\u30e5\u30fc\u3067\u306f\u3001\u30ad\u30e5\u30fc\u306e\u518d\u8a66\u884c\u3092\u3069\u3046\u8a2d\u8a08\u3057\u305f\u304b\u3068\u3001\u30ef\u30fc\u30ab\u30fc\u304c\u6b62\u307e\u3063\u3066\u304b\u3089\u30c8\u30fc\u30af\u30f3\u304c\u5931\u52b9\u3059\u308b\u307e\u3067\u306e\u7336\u4e88\u6642\u9593\u304c\u9069\u5207\u304b\u3069\u3046\u304b\u3092\u3001\u7279\u306b\u898b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002",
