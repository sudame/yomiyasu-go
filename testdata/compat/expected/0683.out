  "flags": [],
  "orig_flags": [
   {
    "note": "\u52d5\u4f5c\u306e\u300c\u301c\u3057\u307e\u3059\u300d\u3068\u3001\u52e7\u3081\u30fb\u4f9d\u983c\u304c\u540c\u3058\u6587\u7ae0\u306b\u3042\u308b\u3002\u300c\u301c\u3057\u307e\u3059\u300d\u304c\u66f8\u304d\u624b\u306e\u5074\u306e\u4e88\u5b9a\u30fb\u6c7a\u307e\u3063\u305f\u624b\u9806\u306a\u306e\u304b\u3001\u8aad\u307f\u624b\u306b\u3057\u3066\u307b\u3057\u3044\u884c\u52d5\u306a\u306e\u304b\u3092\u898b\u308b",
    "sentences": [
     "\u5909\u66f4\u5f8c\u306f\u3001\u6709\u52b9\u671f\u9650\u304c\u8fd1\u3065\u3044\u305f\u30c8\u30fc\u30af\u30f3\u3092\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u8981\u6c42\u3068\u3057\u3066\u30ad\u30e5\u30fc\u3078\u767b\u9332\u3057\u3001\u5c02\u7528\u30ef\u30fc\u30ab\u30fc\u304c\u9806\u6b21\u51e6\u7406\u3057\u307e\u3059\u3002",
     "\u540c\u4e00\u30e6\u30fc\u30b6\u30fc\u306e\u91cd\u8907\u8981\u6c42\u306f\u51aa\u7b49\u30ad\u30fc\u3067\u96c6\u7d04\u3057\u3001\u4e8c\u91cd\u767a\u884c\u3092\u9632\u6b62\u3057\u307e\u3059\u3002",
     "\u5931\u6557\u3057\u305f\u30b8\u30e7\u30d6\u306f\u6307\u6570\u30d0\u30c3\u30af\u30aa\u30d5\u3067\u518d\u8a66\u884c\u3057\u3001\u4e0a\u9650\u56de\u6570\u3092\u8d85\u3048\u305f\u5834\u5408\u306f\u30c7\u30c3\u30c9\u30ec\u30bf\u30fc\u30ad\u30e5\u30fc\u3078\u9000\u907f\u3057\u3066\u76e3\u8996\u30a2\u30e9\u30fc\u30c8\u3092\u767a\u5831\u3057\u307e\u3059\u3002",
     "\u30ec\u30d3\u30e5\u30fc\u3067\u306f\u3001\u30ad\u30e5\u30fc\u306e\u518d\u8a66\u884c\u8a2d\u8a08\u3068\u3001\u30ef\u30fc\u30ab\u30fc\u505c\u6b62\u6642\u306b\u30c8\u30fc\u30af\u30f3\u304c\u5931\u52b9\u3059\u308b\u307e\u3067\u306e\u7336\u4e88\u6642\u9593\u306e\u59a5\u5f53\u6027\u3092\u91cd\u70b9\u7684\u306b\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002"
