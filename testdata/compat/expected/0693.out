    "orig_kind": "\u8aac\u660e\uff08\u301c\u307e\u3059\uff09",
    "rewrite": "\u6b21\u306e3\u70b9\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002",
    "rewrite_kind": "\u52d5\u4f5c\uff08\u301c\u3057\u307e\u3059\uff09"
   }
  ],
  "flags": [
   {
    "note": "\u52e7\u3081\u306e\u6587\u66f8\u306b\u3001\u52d5\u4f5c\u3092\u8868\u3059\u300c\u301c\u3057\u307e\u3059\u300d\u304c\u3042\u308b\u3002\u66f8\u304d\u624b\u306e\u4e88\u5b9a\u3084\u624b\u9806\u30fb\u9053\u5177\u306e\u8aac\u660e\u304b\u3001\u8aad\u307f\u624b\u3078\u306e\u4f9d\u983c\u304b\u3092\u539f\u6587\u3068\u6587\u8108\u304b\u3089\u78ba\u8a8d\u3059\u308b",
    "sentences": [
     "\u30a4\u30f3\u30d5\u30e9\u30c1\u30fc\u30e0\u306f\u4eca\u9031\u672b\u306b\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u306e\u5b9a\u671f\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u3092\u5b9f\u65bd\u3057\u3001\u4f5c\u696d\u4e2d\u306f\u672c\u756a\u30b5\u30fc\u30d3\u30b9\u3092\u4e00\u6642\u505c\u6b62\u3057\u307e\u3059\u3002",
     "\u5bfe\u8c61\u306f\u672c\u756a\u74b0\u5883\u306e\u5168\u30b5\u30fc\u30d3\u30b9\u3067\u3001\u7ba1\u7406\u753b\u9762\u3068API\u3082\u542b\u307f\u307e\u3059\u3002",
     "\u6b21\u306e3\u70b9\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002",
     "\u30a4\u30f3\u30d5\u30e9\u30c1\u30fc\u30e0\u306f\u3001\u4f5c\u696d\u306e\u958b\u59cb\u6642\u3068\u5b8c\u4e86\u6642\u306b\u3053\u306e\u30c1\u30e3\u30f3\u30cd\u30eb\u3078\u6295\u7a3f\u3057\u307e\u3059\u3002",
     "\u4f5c\u696d\u304c\u60f3\u5b9a\u3088\u308a\u9577\u5f15\u304f\u5834\u5408\u3082\u3001\u3053\u306e\u30c1\u30e3\u30f3\u30cd\u30eb\u3067\u968f\u6642\u304a\u77e5\u3089\u305b\u3057\u307e\u3059\u3002",
     "\u3054\u4e0d\u4fbf\u3092\u304a\u304b\u3051\u3057\u307e\u3059\u304c\u3001\u3054\u5354\u529b\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002"
    ]
   }
  ],
  "orig_flags": [
   {
    "note": "\u52e7\u3081\u306e\u6587\u66f8\u306b\u3001\u52d5\u4f5c\u3092\u8868\u3059\u300c\u301c\u3057\u307e\u3059\u300d\u304c\u3042\u308b\u3002\u66f8\u304d\u624b\u306e\u4e88\u5b9a\u3084\u624b\u9806\u30fb\u9053\u5177\u306e\u8aac\u660e\u304b\u3001\u8aad\u307f\u624b\u3078\u306e\u4f9d\u983c\u304b\u3092\u539f\u6587\u3068\u6587\u8108\u304b\u3089\u78ba\u8a8d\u3059\u308b",
    "sentences": [
     "\u4eca\u9031\u672b\u306b\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u306e\u5b9a\u671f\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u3092\u5b9f\u65bd\u3057\u307e\u3059\u3002",
     "\u5bfe\u8c61\u306f\u672c\u756a\u74b0\u5883\u306e\u5168\u30b5\u30fc\u30d3\u30b9\u3067\u3001\u7ba1\u7406\u753b\u9762\u3068API\u3082\u542b\u307f\u307e\u3059\u3002",
     "\u4f5c\u696d\u306e\u958b\u59cb\u6642\u3068\u5b8c\u4e86\u6642\u306f\u3001\u3053\u306e\u30c1\u30e3\u30f3\u30cd\u30eb\u306b\u6295\u7a3f\u3057\u307e\u3059\u3002",
     "\u60f3\u5b9a\u3088\u308a\u9577\u5f15\u304f\u5834\u5408\u3082\u3001\u3053\u306e\u30c1\u30e3\u30f3\u30cd\u30eb\u3067\u968f\u6642\u304a\u77e5\u3089\u305b\u3057\u307e\u3059\u3002",
     "\u3054\u4e0d\u4fbf\u3092\u304a\u304b\u3051\u3057\u307e\u3059\u304c\u3001\u3054\u5354\u529b\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002"
    ]
   }
  ]
